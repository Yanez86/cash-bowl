{$SITE_ADDRESS} {
	# Caddy comprime solo alcuni tipi di file. L'elenco è quello suo di serie,
	# più "application/octet-stream": ci finiscono i dati della lingua per la
	# lettura degli scontrini e il download del database, che comprimendosi
	# dimezzano abbondantemente. Le foto non sono in elenco, e fanno bene:
	# sono già compresse per conto loro.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/wasm*
			header Content-Type application/xhtml+xml*
			header Content-Type application/atom+xml*
			header Content-Type application/rss+xml*
			header Content-Type image/svg+xml*
			header Content-Type application/octet-stream*
		}
	}

	# Registro delle richieste, acceso durante la fase di prova: serve a vedere
	# quali intestazioni manda davvero il browser. Da togliere prima di
	# distribuire, o almeno da mandare su file invece che a schermo.
	log {
		output stdout
		format json
	}

	reverse_proxy app:3000

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}
