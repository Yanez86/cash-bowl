# Copia questo file in ".env" e modifica i valori. Il file ".env" non finisce
# mai su GitHub: contiene la configurazione della TUA installazione.

# Indirizzo su cui l'applicazione risponde.
#   :8080                -> solo in casa, senza HTTPS
#   cash.tuodominio.it   -> raggiungibile da fuori, HTTPS automatico e gratuito
SITE_ADDRESS=:8080

# Indirizzo pubblico completo con cui apri l'app nel browser.
# Serve a proteggere dai moduli inviati da altri siti: deve combaciare esatto.
ORIGIN=http://localhost:8080

# In fase di prova, quando vuoi aprire l'app da indirizzi diversi (dal Mac come
# localhost e dal telefono come 192.168.x.x), commenta la riga ORIGIN qui sopra
# e togli il commento a queste due: l'indirizzo lo dirà Caddy, di volta in volta.
# Rimettere ORIGIN quando l'installazione ha il suo indirizzo definitivo.
#PROTOCOL_HEADER=x-forwarded-proto
#HOST_HEADER=x-forwarded-host

# Quanto può pesare al massimo quello che arriva dal browser. Serve alle foto
# degli scontrini: senza, il limite predefinito è mezzo megabyte.
BODY_SIZE_LIMIT=6M

# Quante copie di sicurezza giornaliere tenere prima di buttare via le più
# vecchie. Metti BACKUP_ENABLED=false solo se fai le copie in un altro modo.
BACKUP_KEEP=14
BACKUP_ENABLED=true

# Il fuso orario del server: decide qual è "oggi" quando registri una spesa
# a tarda sera. Senza questo, il contenitore ragiona in ora di Greenwich.
TZ=Europe/Rome

# Dove finiscono database, backup e foto degli scontrini, dentro il contenitore.
# La cartella "data" del progetto è collegata qui: i tuoi dati restano sul tuo disco.
DATA_DIR=/app/data
