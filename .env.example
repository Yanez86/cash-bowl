# Copia questo file in ".env" e modifica i valori. Il file ".env" non finisce
# mai su GitHub: contiene la configurazione della TUA installazione.

# Indirizzo su cui l'applicazione risponde.
#   :8080                -> solo in casa, senza HTTPS
#   cash.tuodominio.it   -> raggiungibile da fuori, HTTPS automatico e gratuito
SITE_ADDRESS=:8080

# Indirizzo pubblico completo con cui apri l'app nel browser.
# Serve a proteggere dai moduli inviati da altri siti: deve combaciare.
ORIGIN=http://localhost:8080

# Dove finiscono database, backup e foto degli scontrini, dentro il contenitore.
# La cartella "data" del progetto è collegata qui: i tuoi dati restano sul tuo disco.
DATA_DIR=/app/data
